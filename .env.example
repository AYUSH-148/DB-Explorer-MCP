# Copy this file to .env and fill in your own values.
# Never commit real credentials -- .env is gitignored, this example file is not.

# Connect with a database user granted SELECT and nothing else. Privileges are the
# real read-only boundary: without write and file privileges the database itself
# rejects writes and server-file reads such as MySQL LOAD_FILE() or Postgres
# pg_read_file(), which SQL keyword checks cannot reliably block.
#
#   CREATE USER explorer WITH PASSWORD 'choose-a-strong-password';
#   GRANT CONNECT ON DATABASE mydb TO explorer;
#   GRANT USAGE ON SCHEMA public TO explorer;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO explorer;
#
# Omit DATABASE_URL entirely to explore the bundled sqlite sample over stdio.
DATABASE_URL=postgresql://explorer:your-password@localhost:5432/mydb

# stdio for local MCP clients, http when serving over a network.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
