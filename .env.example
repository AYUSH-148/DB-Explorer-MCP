# Copy this file to .env and fill in your own values.
# Never commit real credentials -- .env is gitignored, this example file is not.
# config.py loads .env at startup; real environment variables override it.

# Connect with a database user granted SELECT and nothing else. Privileges are the
DATABASE_URL=postgresql://explorer:your-password@localhost:5432/mydb

# stdio for local MCP clients, http when serving over a network.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

QUERY_TIMEOUT_SECONDS=15
MCP_AUTH_TOKEN=
MCP_ALLOW_UNAUTHENTICATED=false
